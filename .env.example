# ----------------
# 環境固有の秘匿設定（.env にコピーして使用）
# ※ このファイルはテンプレート。実際の値は .env に記載し git には含めない
# ----------------

# OllamaサーバーのURL
OLLAMA_HOST=http://localhost:11434

# LeRobotのインストールパス（フルパスで指定）
LEROBOT_PATH=/home/<username>/lerobot_trossen

# ロボットアームのIPアドレス
ROBOT_IP=192.168.1.4

# Hugging Face のユーザー名（eval データのアップロード先）
HF_USER=your_hf_username

# uv コマンドのフルパス（which uv で確認）
UV_PATH=/home/<username>/.local/bin/uv

# Macでの開発時はtrue → 実コマンドを実行せずシミュレート
DRY_RUN=true

# ----------------
# 外部スクリプト設定
# ----------------
# 【デモ機（共有 Linux PC）では以下の2行を有効にすること】
# 理由: katsube 環境の lerobot .venv が horio のものと差異があり、tools/ 配下のスクリプト実行時にアームが震える
# REACTION_SCRIPT_PATH=/home/share/widowx_reaction_tool/widowx_reaction.sh
# REACTION_RUN_AS_USER=horio
