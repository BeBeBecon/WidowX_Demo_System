# ----------------
# 環境固有の秘匿設定（.env にコピーして使用）
# ----------------

# OllamaサーバーのURL
OLLAMA_HOST=http://localhost:11434

# LeRobotのインストールパス（フルパスで指定）
LEROBOT_PATH=/home/<username>/lerobot_trossen

# ロボットアームのIPアドレス
ROBOT_IP=192.168.1.x

# Hugging Face のユーザー名
HF_USER=your_hf_username

# uv コマンドのフルパス（which uv で確認）
UV_PATH=/home/<username>/.local/bin/uv

# Macでの開発時はtrue → 実コマンドを実行せずシミュレート
DRY_RUN=true
