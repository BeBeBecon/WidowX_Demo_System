{
  "_comment": "公開設定ファイル。秘匿情報（IP・ユーザー名等）は .env に記載すること",

  "model_mode": "TELEOP",

  "payment_demo": {
    "_comment": "スマホ非接触決済デモ画面の表示設定。NFCタグから /payment-demo へ遷移するシナリオ用",
    "merchant_name": "WidowX Demo Store",
    "amount": "¥1,280",
    "currency": "JPY",
    "processing_duration_ms": 2200,
    "success_message": "決済が完了しました",
    "thank_you_message": "ありがとうございました",
    "brand_color": "#2563eb"
  },

  "openvla": {
    "_comment": "OpenVLA モード時の VLA Server 設定。server_url は .env の VLA_SERVER_URL で上書き可",
    "server_url": "http://localhost:8080"
  },

  "ollama": {
    "model": "qwen2.5:3b",
    "timeout": 30
  },

  "robot": {
    "_comment": "ロボット本体の設定。ip_address は .env の ROBOT_IP で上書き",
    "type": "widowxai_follower_robot",
    "id": "follower",
    "max_relative_target": 0.1,
    "min_time_to_move_multiplier": 6.0,
    "cameras": {
      "cam_high": {
        "type": "intelrealsense",
        "serial_number_or_name": "335122270822",
        "width": 640, "height": 480, "fps": 30, "warmup_s": 10
      },
      "cam_wrist": {
        "type": "intelrealsense",
        "serial_number_or_name": "409122272829",
        "width": 640, "height": 480, "fps": 30, "warmup_s": 10
      }
    }
  },

  "record": {
    "_comment": "lerobot-record コマンドの共通オプション（ACTモード用）",
    "display_data": false,
    "push_to_hub": false,
    "num_episodes": 1,
    "episode_time_s": 20,
    "reset_time_s": 5
  },

  "policy": {
    "device": "cuda"
  },

  "dataset": {
    "_comment": "データセット共通設定。ローカルパスは cache_root + '/' + repo_id で自動生成",
    "cache_root": "$HOME/.cache/huggingface/lerobot"
  },

  "llm": {
    "_comment": "LLM挙動設定。trigger_words または predefined_qa にマッチした場合のみ reaction 系スキルを選択肢に追加",
    "yes_no_trigger_words": [
      "できますか", "やってくれますか", "可能ですか", "できる？", "やれる？",
      "いいえ", "違います", "できません", "ちがう", "やめて", "No",
      "そうじゃない", "しないで"
    ],
    "predefined_qa": [
      { "question": "あなたはロボットですか？",     "skill_id": "reaction_yes" },
      { "question": "タッチ決済はできますか？",     "skill_id": "reaction_yes" },
      { "question": "おしゃべりできますか？",       "skill_id": "reaction_no"  },
      { "question": "天気は分かりますか？",   "skill_id": "reaction_no"  }
    ]
  },

  "command_templates": {
    "_comment": "direction_aware スキルのコマンドテキスト生成テンプレート。{name} にスキルの command_verb が代入される",
    "right":  "右側の人に{name}",
    "center": "正面の人に{name}",
    "left":   "左側の人に{name}"
  },

  "a2a": {
    "_comment": "A2A（Agent to Agent）通信レイヤーの設定。agent_url は Main Agent から見たアクセス先URL",
    "agent_name": "WidowX Sub Agent",
    "agent_description": "WidowX ロボットアームを操作するサブエージェント。音声・テキスト命令からスキルを選択して実行する。",
    "agent_url": "http://localhost:8000",
    "agent_version": "1.0.0"
  },

  "skills": [
    {
      "id": "wave_hand",
      "name": "Wave hand",
      "skill_type": "replay",
      "direction_aware": true,
      "command_verb": "手を振って",
      "description": "手を振って挨拶する",
      "variants": {
        "right":  { "repo_id": "docomoshiken1/widowx_wave_right_20260528",  "episode": 0 },
        "left":   { "repo_id": "docomoshiken1/widowx_wave_left_20260528",   "episode": 0 },
        "center": { "repo_id": "docomoshiken1/widowx_wave_center_20260528", "episode": 0 }
      },
      "default_direction": "center",
      "icon": "👋"
    },
    {
      "id": "reaction_yes",
      "name": "Reaction yes",
      "skill_type": "replay",
      "direction_aware": true,
      "command_verb": "うなずいて",
      "description": "うなずいてYesのリアクションをする",
      "variants": {
        "right":  { "repo_id": "docomoshiken1/widowx_reaction_right_yes_20260528",  "episode": 0 },
        "left":   { "repo_id": "docomoshiken1/widowx_reaction_left_yes_20260528",   "episode": 0 },
        "center": { "repo_id": "docomoshiken1/widowx_reaction_center_yes_20260528", "episode": 0 }
      },
      "default_direction": "center",
      "icon": "✅"
    },
    {
      "id": "reaction_no",
      "name": "Reaction no",
      "skill_type": "replay",
      "direction_aware": true,
      "command_verb": "首を横に振って",
      "description": "首を横に振ってNoのリアクションをする",
      "variants": {
        "right":  { "repo_id": "docomoshiken1/widowx_reaction_right_no_20260528",  "episode": 0 },
        "left":   { "repo_id": "docomoshiken1/widowx_reaction_left_no_20260528",   "episode": 0 },
        "center": { "repo_id": "docomoshiken1/widowx_reaction_center_no_20260528", "episode": 0 }
      },
      "default_direction": "center",
      "icon": "❌"
    },
    {
      "id": "contactless_payment",
      "name": "Contactless tap payment",
      "skill_type": "replay",
      "command_verb": "スマホで非接触決済して",
      "description": "スマホをかざして非接触決済する",
      "_comment": "データセット未取得。取得後に repo_id を設定すること",
      "dataset": { "repo_id": "docomoshiken1/widowx_contactless_payment", "episode": 0 },
      "icon": "📱"
    },
    {
      "id": "grab_bottle",
      "name": "Grab the bottle",
      "skill_type": "replay",
      "command_verb": "ペットボトルを掴んで",
      "description": "ペットボトルを掴む",
      "dataset": { "repo_id": "docomoshiken1/widowx_grab_bottle_20260528", "episode": 0 },
      "icon": "🍶"
    },
    {
      "id": "pour_water",
      "name": "Pour water",
      "skill_type": "replay",
      "command_verb": "コップに水を注いで",
      "description": "コップに水を注ぐ",
      "dataset": { "repo_id": "docomoshiken1/widowx_pour_bottle_20260528", "episode": 0 },
      "icon": "💧"
    },
    {
      "id": "grab_cube",
      "name": "Grab the cube",
      "skill_type": "replay",
      "skill_type_alt": "act",
      "_comment": "現在は replay で実行。skill_type_alt=act は将来の ACT 切り替え用の目印",
      "command_verb": "キューブを掴んで",
      "description": "テーブル上のキューブを掴む",
      "dataset": { "repo_id": "docomoshiken1/grab_cube", "episode": 0 },
      "policy_path": "outputs/train/grab_cube_act/checkpoints/last/pretrained_model",
      "icon": "⬛"
    }
  ]
}
